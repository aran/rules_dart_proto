load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_test")
load("@rules_dart_proto//dart_proto:defs.bzl", "dart_proto_toolchain")

dart_proto_toolchain(
    name = "dart_proto_toolchain_impl",
    grpc_runtime = "@pub_deps//:grpc",
    protobuf_runtime = "@pub_deps//:protobuf",
)

toolchain(
    name = "dart_proto_toolchain",
    toolchain = ":dart_proto_toolchain_impl",
    toolchain_type = "@rules_dart_proto//dart_proto:toolchain_type",
)

# Server binary — starts a gRPC server with the Greeter service.
dart_binary(
    name = "server",
    main = "server.dart",
    deps = [
        "//greeter:greeter_dart_proto",
        "@pub_deps//:grpc",
    ],
)

# Client binary — connects to the gRPC server and calls Greet.
dart_binary(
    name = "client",
    main = "client.dart",
    deps = [
        "//greeter:greeter_dart_proto",
        "@pub_deps//:grpc",
    ],
)

# Starts the server in-process and calls it through the generated client.
dart_test(
    name = "greeter_test",
    size = "small",
    main = "greeter_test.dart",
    deps = [
        "//greeter:greeter_dart_proto",
        "@pub_deps//:grpc",
    ],
)
